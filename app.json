{
  "expo": {
    "name": "Turcanime",
    "slug": "turcanime",
    "version": "1.12.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "turcanime",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.turcanime.app",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 11206,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "./plugins/withInstallerQueries.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "66c6dcc9-913f-4f33-941e-fde005fef2e7"
      }
    },
    "owner": "turcaman"
  }
}
